---
# RabbicaOS Calamares 品牌
# 结构依据: Calamares 官方 branding 文档 (BRANDING.md, calamares.io/docs/branding)
# 字段: componentName 决定 /etc/calamares/branding/<componentName>/ 解析目录
componentName: rabbica

strings:
    productName:         RabbicaOS
    shortProductName:    Rabbica
    version:             1.0
    shortVersion:        1.0
    versionedName:       RabbicaOS 1.0 (rbc)
    shortVersionedName:  RabbicaOS 1.0
    bootloaderEntryName: RabbicaOS

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPIVersion:     2

style:
    sidebarBackground:   "#3b2b20"
    sidebarText:         "#f5efe6"
    sidebarTextSelect:   "#c98a4b"
