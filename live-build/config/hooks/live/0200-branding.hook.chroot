#!/bin/sh
# RabbicaOS — 系统品牌化（与 provision/rabbica-provision.sh stage_brand 一致）
# 依据: os-release(5) 字段规范; 保留 DEBIAN_* 字段维持 apt/第三方对底座的识别
set -e
cat > /etc/os-release <<'EOF'
PRETTY_NAME="RabbicaOS 1.0 (rbc)"
NAME="RabbicaOS"
VERSION_ID="1.0"
VERSION="1.0 (rbc)"
VERSION_CODENAME=rbc
ID=rabbicaos
ID_LIKE=debian
HOME_URL="https://github.com/SuceV587/NextKde"
SUPPORT_URL="https://github.com/SuceV587/NextKde"
DEBIAN_VERSION="13"
DEBIAN_CODENAME=trixie
EOF
cat > /etc/lsb-release <<'EOF'
DISTRIB_ID=RabbicaOS
DISTRIB_RELEASE=1.0
DISTRIB_CODENAME=rbc
DISTRIB_DESCRIPTION="RabbicaOS 1.0"
EOF
echo rabbica > /etc/hostname
grep -q "127.0.1.1	rabbica" /etc/hosts || echo "127.0.1.1	rabbica" >> /etc/hosts
cat > /etc/motd <<'EOF'
  ____       ____ _   _    _    ___
 |  _ \ __ _/ ___| | | |  / \  / __)   RabbicaOS (RbcOS)
 | |_) / _` | |   | |_| | / _ \ \__ \  Debian 13 + KDE Plasma 6 + KOS
 |  _ < (_| | |___|  _  |/ ___ \ ( /    Have a cup of coffee & code.
 |_| \_\__,_|\____|_| |_/_/   \_\___)
EOF
echo "[rbc] 品牌化完成"
