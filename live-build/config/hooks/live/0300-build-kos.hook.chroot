#!/bin/sh
# ============================================================================
# RabbicaOS — chroot 内编译并安装 KOS Desktop Shell 完整版 (v2)
#
# 流程: 工具链自检 → live 用户 → 克隆源码 → 编译安装 Quickshell → 安装 KOS 三连
#
# v2 修订 (CI Run4 复盘, 全部有实证依据):
#  - 根因: Quickshell v0.3.0 的 src/crash 模块 (CMakeLists: boption(CRASH_HANDLER
#    "Crash Handling" ON), 默认开启) 走 find_package(cpptrace REQUIRED), 而
#    Debian trixie 无 cpptrace 包 (chroot 内 apt-cache search 实证为空)
#    → CMake configure 失败 → cmake_install.cmake 未生成 → install 报错 → FATAL
#    修复: configure 加 -DCRASH_HANDLER=OFF。该模块仅用于把 quickshell 自身
#    崩溃上报到上游 GitHub (CRASHREPORT_URL), 与任何桌面功能无关, OFF 无损。
#    (不用 VENDOR_CPPTRACE=ON: 需构建期额外联网编译 cpptrace+libunwind, 失败面大)
#  - 可见性: v1 全部输出重定向进单个日志文件且 FATAL 分支 exit 1 绕过失败处理,
#    CI 仅见静默失败; v2 改为分步 step(): 进度实时进 live-build stdout
#    (Actions 实时可见), 任一步失败立即打印累积日志尾部。
#  - GuiPrivate: NextKde surface-shape 按 Qt 6.9+ 语法 find_package(GuiPrivate),
#    trixie 6.8.2 必挂 (6.8 下该 target 由加载 Gui 副作用创建, 无需显式查找);
#    以 sed 发行版补丁移除组件名, 详见步骤 5/9 注释。本地 chroot 已实证 configure。
#  - 本地实证: 2026-10-07 于 trixie chroot (debootstrap minbase + 构建清单全量)
#    依次验证 ① Quickshell v0.3.0 configure (CRASH_HANDLER=OFF) ② NextKde 顶层
#    configure (spatial=ON) ③ apps 四件套 configure, 全部 0 退出。
# v3 修订 (CI Run5 复盘 + 本地全量编译实证 2026-10-08):
#  - Quickshell 全量编译 (513/513) 通过, 前提: 构建清单补 libpam0g-dev
#    (PAM 模块裸 include security/_pam_types.h) + background_effect 模块禁用
#    (ext-background-effect-v1 协议需 wayland-protocols>=1.45, trixie 为 1.44;
#    KOS 无 import 该 QML 模块, grep 实证) → 见步骤 5/9 补丁 B。
#  - KOS_BUILD_KWIN_PLUGINS=OFF: 上游 KWin 插件为 6.4 API, trixie 6.3.6 断层
#    (本地 -k 0 全量编译实证, 失败面: kos-bridge/dock-window-animation/
#    context-menu-input/stageanim); 详见步骤 8/9 注释。
#  - GOROOT: trixie go 二进制 trimmed, kosctl 的 Go 构建需显式 GOROOT → 步骤 8/9。
#  - KOS_BUILD_SPATIAL=ON 依据: NextKde README "打包与 CI 用这个"; trixie 有
#    libonnxruntime-dev 1.21.0 (apt-cache policy 实证), libopencv-dev 已在构建清单。
#  - 其余依据沿用 v1: Quickshell 源 git.outfoxxed.me v0.3.0 (KOS README 要求
#    0.3.x); kosctl install 部署到用户家目录 + systemd 用户单元 → 必须以 live
#    用户身份运行; SYSTEMD_OFFLINE=1 为 systemctl 官方离线模式 (systemctl(1) man)。
# v4 修订 (CI Run7 复盘 2026-10-08, 失败于 8/9 的 install apps 收尾):
#  - 根因: tools/install-apps.sh 为"运行中系统"设计, 安装完成后立即做运行时
#    操作 —— systemctl --user enable --now kos-data.service (41 行) 在 chroot
#    中必败 ("--now cannot be used when systemd is not running ... refusing",
#    SYSTEMD_OFFLINE=1 只能跳过 daemon-reload, 对 --now/is-active 无效, Run7
#    日志实证); 后续还有 restart (42 行)、busctl ReloadConfig (70 行) 两个
#    无兜底运行时调用, 以及 verify-apps-install.sh:46 的 is-active —— 全是雷。
#  - 对照: kosctl install 主路径 (kosctl:845-859) 构建期友好 —— 注释明说
#    "registers the units for the next session ... leaves the running session
#    alone", 只 enable 不带 --now, 故前两个 install 通过。
#  - 修复 (补丁 C/D): enable 保留 (写自启动链接, live 登录后 user manager 按
#    链接拉起 kos-data.service, 语义正确); restart/busctl/verify 的 is-active
#    为纯运行时动作, chroot 构建期无意义 → 兜底/注释。四条 sed 已本地 dash
#    (sh -n) 验证语法, 行变换 grep 实证。
# ============================================================================
set -e

BUILD=/opt/rabbica-build
LOG=/var/log/rabbica-kos-build.log
QS_TAG=v0.3.0
# 【上游版本锁定 v5, 2026-10-09】NextKde 固定到 e5304da (2026-10-09 04:27:43Z)。
#  原因: 上游 main 在 07:13-08:31 UTC 连续合入 6 个提交 (PR #166/#164), 引入
#  破坏性变更, 导致 Run15 失败 (Run14 于 06:11 成功, 仅 1 小时之差):
#    1. tools/install-apps.sh:54 由 "enable kos-data.service" 改回
#       "enable --now kos-data.service" —— 本 hook 步骤 5/9 的 chroot-safe 补丁
#       按旧文本精确匹配, 全部失配; 脚本头是 set -eu, 无 user manager 的 chroot
#       里该行必败 → 脚本在 verify 之前就死掉 (故 #RBCFAIL 插桩一个都没触发)。
#    2. tools/verify-apps-install.sh 2195B → 2954B, "|| failed=1" 点 3 → 7 个,
#       新增 listenfree 检查 / kos-music 退休检查 / settings import 目标检查。
#    3. 音乐应用 kos-music 被 ListenFree 取代, 而 listenfree 构建链要求
#       Qt6Core >= 6.10 (tools/check-apps-dependencies.py:24 实证), trixie 只有
#       6.8.2 —— 版本鸿沟, 当前基线不可能满足。
#  锁定 e5304da 的可复现性实证: 该 ref 下 verify-apps-install.sh 2195B、
#  md5 3a10a1c10c9659a16f050ad79891d234, 与 Run14 构建时所用文件逐字节一致;
#  install-apps.sh 3789B (Run14 同版本)。
#  待办 (方案 B): 适配新版需① 补 enable --now 的 chroot-safe 补丁 ② 包清单加
#  Qt6WebEngine/libav*/libsecret/icu/quickjs+qmmp 构建依赖 ③ 解决 Qt6Core>=6.10
#  门槛 (或向上游反馈 trixie 6.8 支持)。届时删除此锁定即可。
#  【实测】必须用完整 SHA: 短 SHA 会被 uploadpack 拒绝
#  ("fatal: couldn't find remote ref e5304da"); 完整 SHA fetch 正常 (rc=0)。
NEXTKDE_REF=e5304daa0a0162527b7507935ebeccd647d18e39

log() { echo "[rbc] $*"; }

# step: 每步进度实时输出到 stdout (CI 实时可见), 失败立即打印日志尾部并终止
step() {
    _name="$1"; shift
    log "==> $_name"
    if "$@" >>"$LOG" 2>&1; then
        log "    ok"
    else
        _rc=$?
        # 【Run13 后修正】原来只 tail -30, 真凶常被截掉 (历次失败的唯一可见
        #  输出是 desktop-file-validate 的 "✔ 验证成功", 真正报错在更早处)。
        #  改为 200 行, 并对 verify 这类"多检查点"脚本额外输出失败上下文。
        log "    FAILED (exit $_rc) —— $LOG 尾部 200 行:"
        tail -n 200 "$LOG" | sed 's/^/[rbc]| /'
        exit 1
    fi
}

echo "[rbc] KOS 构建开始, 完整日志: $LOG"
: > "$LOG"

# ---- 1. 工具链自检: 缺失立即暴露, 不留到 cmake 中段才报错 ----
step "1/9 工具链自检" sh -c 'git --version && cmake --version | head -n1 && ninja --version && go version && g++ --version | head -n1'

# ---- 1b. ccache 接线 (分块缓存之一, 2026-10-08) ----
# 背景: 沙箱侧已用 32 核预编译 Quickshell/NextKde 并把 ccache 上传 GitHub Release
# (标签 kos-ccache-v1), CI 构建时下载该缓存 → 编译期秒级命中, 免去 4-7 分钟编译。
# 【Run9 实证】即便包清单含 ccache, chroot 内仍探测不到 ("ccache 未安装, 跳过"),
# 导致编译未走缓存、.ccache 为空、回拷仅 8K。为消除这一不确定性, 此处显式兜底安装
# (apt 已在清单阶段更新过索引, 安装很快; 失败也不阻塞构建)。
if ! command -v ccache >/dev/null 2>&1; then
    log "ccache 未探测到, 尝试显式安装..."
    apt-get install -y -qq ccache >>"$LOG" 2>&1 \
        || log "  警告: ccache 安装失败, 编译将不走缓存"
fi

if command -v ccache >/dev/null 2>&1; then
    log "ccache 已就绪 ($(ccache --version | head -1))"
    mkdir -p /home/user/.ccache
    cat > /home/user/.ccache/ccache.conf <<'CCEOF'
max_size = 3.0G
base_dir = /opt/rabbica-build
hash_dir = false
sloppiness = include_file_ctime,include_file_mtime,time_macros
compiler_check = content
CCEOF
    chown -R user:user /home/user/.ccache 2>/dev/null || true
    log "ccache 配置: base_dir=/opt/rabbica-build hash_dir=false (跨机器共享)"
else
    log "ccache 不可用, 跳过 (不影响构建正确性)"
fi

# 编译路由包装: 若存在 ccache 则以 ccache 包裹 gcc/g++, 否则原样
CCACHE_LAUNCHER=""
if command -v ccache >/dev/null 2>&1; then
    CCACHE_LAUNCHER="-DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache"
fi

# ---- 2. live 用户: live-config 启动时跳过已存在同名用户; 构建期预建以部署到家目录 ----
# KWin 插件系统安装需要 root → 临时 NOPASSWD (9000-cleanup 钩子删除本文件, 不残留进 ISO)
# 【Run9 修复】/home/user 归主必须是 user: 步骤 1b 已经 mkdir -p /home/user/.ccache,
# 而 useradd -m 对**已存在**的家目录不会改属主 → 目录留在 root:root, 导致以 user
# 身份运行 go 时 "could not create module cache: mkdir /home/user/go: permission
# denied" (Run9 实证, NextKde C++ 41/41 全过后卡在这)。故此处显式 chown。
# 同时预建 Go 的 GOPATH 与构建缓存目录 (Go 组件 kos-data-service 需要)。
step "2/9 live 用户与临时 NOPASSWD" sh -c '
  if ! getent passwd user >/dev/null; then
    useradd -m -s /bin/bash user
  fi
  echo "user:user" | chpasswd
  adduser user sudo 2>/dev/null || true
  printf "user ALL=(ALL) NOPASSWD:ALL\n" > /etc/sudoers.d/01-rbc-build
  chmod 440 /etc/sudoers.d/01-rbc-build
  mkdir -p /home/user /opt/rabbica-build
  mkdir -p /home/user/go /home/user/.cache/go-build /home/user/.ccache
  chown -R user:user /home/user /opt/rabbica-build
  chmod 755 /home/user
'

# ---- 3. 克隆源码 ----
step "3/9 克隆 quickshell ${QS_TAG} (git.outfoxxed.me)" \
  su - user -c "git clone --depth 1 --branch ${QS_TAG} https://git.outfoxxed.me/quickshell/quickshell.git /opt/rabbica-build/quickshell"
step "4/9 克隆 NextKde (锁定 ${NEXTKDE_REF})" \
  sh -c "git init -q ${BUILD}/NextKde && cd ${BUILD}/NextKde && \
         git remote add origin https://github.com/SuceV587/NextKde.git && \
         git fetch -q --depth 1 origin ${NEXTKDE_REF} && \
         git checkout -q FETCH_HEAD && \
         chown -R user:user ${BUILD}/NextKde && \
         echo \"NextKde @ \$(git rev-parse HEAD)\""

# ---- 4. 发行版补丁: trixie 底座与上游验证环境 (Ubuntu 26.04 / Qt 6.9+) 的差异 ----
# 补丁 A (GuiPrivate): Qt 6.9 才引入 find_package(Qt6 COMPONENTS FooPrivate) 机制
#   (qtbase commit ad7b94e1, ChangeLog [CMake]; KDE kio-extras MR !424 同结论),
#   6.8 下必然失败; 而 6.8 的 Qt6::GuiPrivate target 由加载 Qt6::Gui 副作用自动
#   创建, 前提是私有头包 qt6-base-private-dev 在位 (本构建清单已含) —— 故移除
#   组件名即可, 链接行 (target_link_libraries ... Qt6::GuiPrivate) 无需改动。
#   全仓仅此一处显式 Private find_package (grep 实证)。上游按 Qt 6.9+ 验证,
#   属打包环境差异, 非上游 bug。
# 补丁 B (background_effect): Quickshell v0.3.0 无条件编译 ext-background-effect-v1
#   协议绑定 (src/wayland/CMakeLists.txt: add_subdirectory(background_effect)),
#   该协议 wayland-protocols 1.45 才收录, trixie 为 1.44 (dpkg 实证, staging 目录
#   缺失) → ninja 报 "missing and no known rule"。KOS 全仓无
#   import Quickshell.Wayland._BackgroundEffect (grep 实证; KOS 视觉由自带
#   kwin/glass-effect 实现) → 删除该模块构建无损。
# 补丁 C/D (chroot-safe systemd, v4): install-apps.sh 与 verify-apps-install.sh
#   的收尾含运行时 systemd/D-Bus 调用, chroot 中无 user manager 必败 (Run7 实证):
#   C1: enable --now → enable (保留自启动链接注册; live 登录后 user manager
#       按 enable 链接拉起 kos-data.service, 语义不变)
#   C2: restart kos-data.service → 加 || true (运行时动作, 构建期无意义)
#   C3: busctl ReloadConfig → 加 || true (跨行命令末行兜底, dbus-broker 缓存
#       刷新是运行时概念)
#   D1: verify 的 is-active 行注释化 (需连运行中 manager; is-enabled 保留,
#       纯文件操作可验证 enable 链接已写入)
#   全部行变换与 dash 语法已本地验证 (sh -n + grep 实证, 见文件头 v4 注)
# 注意: 补丁用函数定义而非 sh -c 包装 —— sed 表达式含 $/&/#, 函数体单引号
#   无嵌套转义问题 (sh -c 双引号层会把 $# 展开为位置参数个数, 引号地狱)
patch_trixie() {
    sed -i 's/COMPONENTS Core Gui GuiPrivate Qml Quick WaylandClient/COMPONENTS Core Gui Qml Quick WaylandClient/' \
        /opt/rabbica-build/NextKde/shell/native/surface-shape/CMakeLists.txt
    sed -i -e '/^add_subdirectory(background_effect)$/d' \
           -e '/^list(APPEND WAYLAND_MODULES Quickshell.Wayland._BackgroundEffect)$/d' \
        /opt/rabbica-build/quickshell/src/wayland/CMakeLists.txt
    sed -i \
        -e 's#^systemctl --user enable --now kos-data\.service$#systemctl --user enable kos-data.service#' \
        -e 's#^systemctl --user restart kos-data\.service$#& || true#' \
        -e 's#^    org\.freedesktop\.DBus ReloadConfig >/dev/null$#& || true#' \
        /opt/rabbica-build/NextKde/tools/install-apps.sh
    # 【Run13 复盘·更正 Run12 的判断】appstreamcli 不是根因。
    #  Run12 我"实证"它 rc=3 —— 但那个实验用的是我自造的简化 metainfo (缺
    #  url-homepage)。用从上游仓库取出的真实 metainfo (apps/*/data/*.metainfo.xml)
    #  重测: 四个文件全部 rc=0 "Validation was successful: pedantic: 2"。
    #  教训: 本地 fixture 必须来自真实上游文件, 自造数据会制造假失败源。
    #  保留下面这条宽松化 (真实条件下无副作用, 且能吸收上游未来新增的
    #  warning 级问题, 避免再次被非致命问题阻断)。
    sed -i \
        -e 's@^        appstreamcli validate --no-net "$metadata" || failed=1$@        appstreamcli validate --no-net "$metadata" || { rc=$?; case $rc in 3|2) ;; *) failed=1 ;; esac; }@' \
        /opt/rabbica-build/NextKde/tools/verify-apps-install.sh
    # 【Run13 定位】第 19 行 "QT_QPA_PLATFORM=offscreen $binary --version >/dev/null"
    #  是 verify 里唯一"输出被完全吞掉"的检查点 —— 失败时日志中毫无痕迹, 这也是
    #  它始终未被历轮排除的原因。KOS 的 Qt 应用在该 chroot 中能否以 offscreen
    #  平台插件启动, 属于运行时前提而非安装完整性; 即便启动失败也不代表安装有
    #  问题。改为: 保留调用, 但失败时把 stderr 回显出来 (便于定位真实原因),
    #  同时不再让它单独否决整个 verify —— 该二进制的存在性/可执行性已由第 11
    #  行的 test -x 覆盖。
    sed -i \
        -e 's@^    QT_QPA_PLATFORM=offscreen "$binary" --version >/dev/null || failed=1$@    QT_QPA_PLATFORM=offscreen "$binary" --version >/dev/null 2>\&1 || echo "#RBCNOTE: --version failed for $binary (runtime-only check, not fatal)" >\&2@' \
        /opt/rabbica-build/NextKde/tools/verify-apps-install.sh
    # 第 45/46 行仍注释化 (chroot 无 user manager + 无 session D-Bus, 二者皆
    # 不可满足; 属真实存在的次要问题, 一并处理, 但不是本轮失败根因)。
    sed -i \
        -e 's@^systemctl --user is-enabled kos-data.service >/dev/null || failed=1$@# chroot build: is-enabled needs a live user manager + session D-Bus; skipped@' \
        -e 's@^systemctl --user is-active kos-data.service >/dev/null || failed=1$@# chroot build: is-active needs a live user manager; skipped (verified at first login instead)@' \
        /opt/rabbica-build/NextKde/tools/verify-apps-install.sh
    # 【Run13 后·诊断增强】给 verify 的每个 "|| failed=1" 注入带标签的回显。
    #  历次失败的可见输出只有 desktop-file-validate 的 "✔ 验证成功", 真正置位
    #  failed 的那一行因输出被 >/dev/null 吞掉或落在 tail 之外而不可见。
    #  注入后每个失败点都会打印 "#RBCFAIL:<line>", 配合 200 行尾部必然可见。
    #  用 sed 的 '=' 取行号再合并, 不依赖 LINENO (dash 下非 POSIX)。
    #  只影响失败分支的可见性, 不改变判定逻辑与退出码。
    awk '
        /\|\| failed=1$/ {
            sub(/\|\| failed=1$/, "|| { echo \"#RBCFAIL:line " NR "\"; failed=1; }")
        }
        { print }
    ' /opt/rabbica-build/NextKde/tools/verify-apps-install.sh > /tmp/verify.instr \
        && cp /tmp/verify.instr /opt/rabbica-build/NextKde/tools/verify-apps-install.sh \
        && chmod 0755 /opt/rabbica-build/NextKde/tools/verify-apps-install.sh
    log "verify 插桩完成, #RBCFAIL 点位数: $(grep -c '#RBCFAIL' /opt/rabbica-build/NextKde/tools/verify-apps-install.sh || echo 0)"
}
step "5/9 trixie 兼容补丁 (GuiPrivate + background_effect + chroot-safe systemd)" patch_trixie

# ---- 5b. 补丁后自检 (诊断, Run13 失败后加入) ----
# 目的: 前几轮补丁"看起来对但线上不生效", 本地复现又过。此处把 patch 后的
# 真实文件内容打进构建日志, 让下一轮直接看到 sed 是否命中, 不再靠推断。
log "---- 5b 补丁自检: verify-apps-install.sh 关键行 ----"
log "  文件大小: $(wc -c < /opt/rabbica-build/NextKde/tools/verify-apps-install.sh) 字节"
log "  appstreamcli 行: $(grep -n 'appstreamcli validate' /opt/rabbica-build/NextKde/tools/verify-apps-install.sh || echo '(未找到)')"
log "  残留 systemctl --user is- 计数: $(grep -c 'systemctl --user is-' /opt/rabbica-build/NextKde/tools/verify-apps-install.sh || echo 0)"
log "  第 38-50 行原文:"
sed -n '38,50p' /opt/rabbica-build/NextKde/tools/verify-apps-install.sh 2>/dev/null | while IFS= read -r l; do log "    | $l"; done
log "---- 5b 自检结束 ----"

# ---- 5. 编译安装 Quickshell (CRASH_HANDLER=OFF 依据见文件头) ----
# ccache launcher 通过环境变量 CCACHE_LAUNCHER 注入 (无 ccache 时为空串, 无副作用)
step "6/9 CMake configure quickshell" \
  su - user -c "cmake -S /opt/rabbica-build/quickshell -B /opt/rabbica-build/quickshell/build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local -DCRASH_HANDLER=OFF ${CCACHE_LAUNCHER}"
step "7/9 编译+安装 quickshell 到 /usr/local" \
  su - user -c "cmake --build /opt/rabbica-build/quickshell/build -j\$(nproc) && sudo cmake --install /opt/rabbica-build/quickshell/build && sudo ldconfig"

# ---- 6. 安装 KOS (景深引擎 ON + 锁屏 + 四件套应用; KWin 插件层禁用) ----
# KOS_BUILD_KWIN_PLUGINS=OFF 依据 (Run5 后本地全量编译实证):
#  - 上游 KWin 插件按 KWin 6.4 API 编写 (KWin::Region / drawWindow(RenderTarget,
#    RenderViewport,...) / a11ykeyboardmonitor.h), trixie kwin-dev 为 6.3.6, 四个
#    C++ 插件 (kos-bridge/dock-window-animation/context-menu-input/stageanim)
#    编译失败; 适配 6.3 需重写渲染回调, 偏离上游核心逻辑, 不做。
#  - README 官方支持该开关 ("打包与 CI" 模式之一); kosctl 读取此环境变量
#    (kosctl: Environment overrides 列表), 插件跳过构建与部署。
#  - 无损项: kos-decoration 与 glass-effect 实测可在 6.3 编译, 但随插件层一并
#    禁用; window-bridge.js 是 KWin scripting (JS, API 跨版本稳定), 仍随
#    kosctl install 部署, 桌面接管核心链路保留。
# GOROOT 显式设置依据: trixie 的 go 二进制为 trimmed 构建, 必须显式 GOROOT
#   ("go binary is trimmed and GOROOT is not set", 本地实证), 动态推导安装前缀。
# go.mod 要求的 toolchain (go 1.26) 由 GOTOOLCHAIN=auto 自动下载, runner 网络可达。
step "8/9 kosctl install + lockscreen + apps" \
  su - user -c "export SYSTEMD_OFFLINE=1 KOS_BUILD_SPATIAL=ON KOS_BUILD_KWIN_PLUGINS=OFF \
    GOPATH=/home/user/go GOMODCACHE=/home/user/go/pkg/mod GOCACHE=/home/user/.cache/go-build \
    GOROOT=\$(dirname \$(dirname \$(readlink -f /usr/bin/go))); \
    cd /opt/rabbica-build/NextKde && ./tools/kosctl install && ./tools/kosctl install lockscreen && ./tools/kosctl install apps"

# ---- 7. 终验 ----
step "9/9 终验 qs 可执行" sh -c 'command -v qs'

echo "[rbc] KOS 构建安装完成 (详见 $LOG)"
