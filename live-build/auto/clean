#!/bin/sh
# 重置 live-build 构建目录 (Debian Live Manual: auto/clean 惯例)
#
# 【2026-10-08 修复 · 缓存失效根因】
# 原实现: `lb clean noauto --purge` + 无条件 `rm -rf .build/`。
#   - `lb clean --purge` 语义是 "removes everything, including all caches"
#     (lb clean(1) 原文实证) → 把 apt 包缓存清掉;
#   - 且原 rm 目标路径本身也是错的 (包缓存不在 .build/ 下)。
# 这导致 workflow 的 "restore 缓存 → clean(清缓存) → build" 顺序永远达不到
# "复用上次下载的包" 的效果 —— 是 8 轮 CI 每轮重下 1900+ 包 (~45min) 的直接原因。
#
# 【正确路径】live-build 的包缓存位于 **cache/packages** 与 **cache/apt**
# (由 config/common 的 LB_CACHE_PACKAGES="true" 控制; 在 /usr/lib/live/build
#  中 grep 实证 "cache/packages" 字样), 相对于 lb 工作目录, 不是 .build/。
#
# 现行为: 默认保留 cache/; `lb clean noauto` 不带 --purge (官方 --all 语义已
# 注明 "The cache directory is kept")。仅显式传 --purge-cache 时才连缓存一起清。
PURGE_CACHE=0
CLEAN_ARGS=""
for arg in "$@"; do
    case "$arg" in
        --purge-cache) PURGE_CACHE=1 ;;
        --purge)       ;;   # 吞掉 --purge: 不再让 lb clean 清包缓存
        *)             CLEAN_ARGS="$CLEAN_ARGS $arg" ;;
    esac
done

# shellcheck disable=SC2086
lb clean noauto $CLEAN_ARGS
rm -f config/package-lists/*.list.chroot.bak 2>/dev/null || true

if [ "$PURGE_CACHE" = "1" ]; then
    echo "[clean] --purge-cache: 清除 cache/ (apt 包缓存)"
    rm -rf chroot/ binary/ local/ cache/ .build/ 2>/dev/null || true
else
    if [ -d cache ]; then
        echo "[clean] 保留 apt 包缓存 cache/: $(du -sh cache 2>/dev/null | cut -f1)"
    fi
    rm -rf chroot/ binary/ local/ 2>/dev/null || true
    # .build/ 下保留 config (lb config 的产物), 其余清掉
    find .build -mindepth 1 -maxdepth 1 ! -name config -exec rm -rf {} + 2>/dev/null || true
fi
